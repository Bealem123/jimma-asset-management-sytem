PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=jimma_ams
DB_PASSWORD=change_me
DB_NAME=jimma_ams
DB_NAME_TEST=jimma_ams_test
JWT_SECRET=change_me_long_random
JWT_EXPIRES_IN=8h
UPLOAD_DIR=uploads
SEPARATION_OF_DUTIES=true

# --- Public address of the system. If set, printed QR codes open the asset in the browser when scanned
#     with an ordinary phone camera. Without it the QR code holds just the Asset ID (for the in-app scanner).
# PUBLIC_URL=https://assets.jimma.gov.et

# --- E-mail for notifications and scheduled reports (leave SMTP_HOST empty to disable)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Jimma Asset Management <no-reply@jimma.gov.et>

# --- SMS through any HTTP gateway that accepts {"to": "...", "message": "..."} (leave empty to disable)
# SMS_GATEWAY_URL=
# SMS_GATEWAY_TOKEN=

# --- Backups
# BACKUP_DIR=backups              # put this on another disk, and copy it off-site
# MYSQLDUMP_PATH=mysqldump        # full path if mysqldump is not on PATH, e.g. C:/wamp64/bin/mysql/mysql8.4.7/bin/mysqldump.exe
# AUTO_BACKUP=true                # take a database + files backup once a day while the server is running

# --- Security (docs/SECURITY.md). The defaults below are used when a line is left out.
# SESSION_IDLE_MINUTES=30         # a session with no activity for this long ends
# TEMP_PASSWORD_DAYS=7            # a temporary password (new account, reset) works this many days
# API_RATE_PER_MINUTE=600         # requests a minute from one address, whole API
# LOGIN_RATE_PER_MINUTE=20        # sign-in attempts a minute from one address
# PUBLIC_RATE_PER_MINUTE=120      # public asset card views a minute from one address
# --- AI assistant (the chat button at the bottom right). Leave AI_BASE_URL empty to switch it off.
#     Any service with an OpenAI-compatible chat API works. Free choices:
#       Google Gemini (free key at https://aistudio.google.com/apikey):
#         AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#         AI_MODEL=gemini-3.5-flash
#         AI_REASONING_EFFORT=low     # answers in seconds instead of thinking at length
#       Groq (free key at https://console.groq.com/keys):
#         AI_BASE_URL=https://api.groq.com/openai/v1
#         AI_MODEL=llama-3.3-70b-versatile
#       Ollama on this server (no key, data stays on the City's server):
#         AI_BASE_URL=http://127.0.0.1:11434/v1
#         AI_MODEL=qwen2.5:7b
#     On free cloud tiers the provider may keep and use what is sent: the City must agree before real data is used.
# AI_BASE_URL=
# AI_API_KEY=
# AI_MODEL=
# AI_RATE_PER_MINUTE=10           # questions a minute per person
